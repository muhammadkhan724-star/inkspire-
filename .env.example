# InkSpire Configuration Environment Variables
APP_ENV=development
SECRET_KEY=generate_a_random_32_byte_secret_key_here_or_leave_empty_for_auto
DATABASE_PATH=app/data/inkspire.db

# Site SEO & Identity Defaults
SITE_NAME="InkSpire"
SITE_TAGLINE="Modern Publishing & High-Performance SEO Engine"
SITE_URL="http://127.0.0.1:8000"
SITE_DESCRIPTION="Enterprise-grade blogging platform engineered for search engine dominance and uncompromised security."
SITE_AUTHOR="InkSpire Editorial"
SITE_TWITTER="@inkspireblog"

# Default Admin Credentials (Auto-seeded on first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@inkspire.local
ADMIN_PASSWORD=InkSpire@2025Secure!

# File Upload Security Settings
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif

# Rate Limiting
RATE_LIMIT_ENABLED=true
